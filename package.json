{
  "name": "pedagang-keliling-supabase",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:host": "node ./node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "lint": "eslint src server",
    "test": "vitest run",
    "test:sql": "node scripts/validate-sql.mjs",
    "check": "npm run lint && npm run test && npm run test:sql && npm run build && node --check server/app.js",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "preview:host": "node ./node_modules/vite/bin/vite.js preview --host 0.0.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.32.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.14",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "pgsql-parser": "^17.9.15",
    "postcss": "^8.4.23",
    "tailwindcss": "^3.4.5",
    "vite": "^7.1.4",
    "vitest": "^4.1.9"
  }
}
