{
  "name": "pedagang-keliling-supabase",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:host": "node ./node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "lint": "eslint src server public/sw.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sql": "node scripts/validate-sql.mjs",
    "test:ui": "node scripts/test-pickup-ui.mjs",
    "test:ui:public": "node scripts/test-public-ui.mjs",
    "test:ui:pwa": "node scripts/test-pwa-ui.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:sql && npm run build && node --check server/app.js",
    "check:release": "npm run check && npm run test:ui && npm run test:ui:public && npm run test:ui:pwa",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "preview:host": "node ./node_modules/vite/bin/vite.js preview --host 0.0.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.32.0",
    "@tanstack/react-query": "^5.104.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.57.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "pgsql-parser": "^17.9.15",
    "playwright": "1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.4",
    "vitest": "^4.1.9"
  }
}
