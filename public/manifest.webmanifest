  "description": "Peta, order, chat, dan tracking pedagang keliling di sekitar Anda.",
  "lang": "id-ID",
  "dir": "ltr",
  "start_url": "/map?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
